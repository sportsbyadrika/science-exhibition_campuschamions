# ---------------------------------------------------------------------
# Sahodaya Science Fair Portal - environment configuration
# Copy to .env (same folder as index.php) and fill in real values.
# .env is never committed and is not overwritten by cPanel deployment.
# ---------------------------------------------------------------------

APP_NAME="Sahodaya Science Fair Portal"
APP_ENV=production
# Public URL of the site, no trailing slash
APP_URL=https://science_expo.sportsmis.com
APP_TIMEZONE=Asia/Kolkata

# MySQL (cPanel > MySQL Databases; names are prefixed with the cPanel user)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sportsby_science_expo
DB_USERNAME=sportsby_science_expo
DB_PASSWORD=

# One-time browser installer (/install). Set a long random value, open
# https://<your-domain>/install, then REMOVE this line after installing.
INSTALL_KEY=

# Upload limits (KB)
UPLOAD_MAX_PHOTO_KB=1024
UPLOAD_MAX_RECEIPT_KB=5120

# Email (PHPMailer). When MAIL_HOST is set these values override the
# SMTP fields in Admin > Settings. Leave MAIL_HOST empty to manage SMTP
# from the admin panel instead.
MAIL_ENABLED=true
MAIL_HOST=mail.sportsmis.com
MAIL_PORT=465
# tls (STARTTLS, usually 587) | ssl (usually 465) | none
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@sportsmis.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@sportsmis.com
MAIL_FROM_NAME="Sahodaya Science Fair"
