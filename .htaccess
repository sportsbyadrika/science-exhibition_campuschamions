# ---------------------------------------------------------------------
# Clean URLs: /admin/events  ->  admin/events.php  (".php" never shown)
# ---------------------------------------------------------------------
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the portal lives in a sub folder, set it here, e.g. RewriteBase /sciencefair/
  RewriteBase /

  # Block internal folders and dot-files
  RewriteRule ^(includes|config|database|storage|vendor|bin|node_modules)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|router\.php|README\.md|\.user\.ini)$ - [F,L]

  # Externally redirect "/page.php" and "/index" to the extension-less URL
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index(?:\.php)?[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Internally map "/page" to "page.php"
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # Folder index (e.g. /admin -> admin/index.php)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.php -f
  RewriteRule ^(.+?)/?$ $1/index.php [L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "(^\.env.*|\.(sql|log|md|lock|ini|sh|yml))$">
  Require all denied
</FilesMatch>
